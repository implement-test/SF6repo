{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "sf6-repository",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // 사이트 주소. 배포할 때 DNS 레코드와 인증서가 자동으로 만들어진다 (nogamenogain.com 영역이 같은 계정에 있어야 함)
  "routes": [{ "pattern": "sf6.nogamenogain.com", "custom_domain": true }],
  // routes 가 있으면 workers.dev 주소가 기본으로 꺼진다. 새 주소가 열릴 때까지 켜 둔다
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // 자기 자신을 가리키는 서비스 바인딩. service 이름은 위 name 과 같아야 한다.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "sf6-repository"
    }
  ],
  "r2_buckets": [
    {
      // ISR 캐시용 버킷
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "sf6-repository-opennext-cache"
    }
  ],
  "d1_databases": [
    {
      // 태그 캐시: 관리자가 저장할 때 revalidatePath 로 무효화한 경로를 기록한다
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "sf6-repository-tag-cache",
      "database_id": "c53d0e10-0eea-4bc7-b3e4-7e484a7acff7"
    }
  ]
}
